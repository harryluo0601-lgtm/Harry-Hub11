local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local LocalPlayer = Players.LocalPlayer

-- === ⚙️ 初始預設參數 ===
local CurrentSize = 15          -- 預設初始大小
local CurrentTransparency = 0.6 -- 預設初始透明度 (0.6 為半透明紅塊)

-- === ⌨️ 調整按鍵配置 ===
local KEY_SIZE_UP = Enum.KeyCode.RightBrackets   -- 按鍵盤 [ ] 的 ] 鍵：方塊變大 (+2)
local KEY_SIZE_DOWN = Enum.KeyCode.LeftBrackets  -- 按鍵盤 [ ] 的 [ 鍵：方塊變小 (-2)
local KEY_TOGGLE_HIDE = Enum.KeyCode.BackSlash   -- 按鍵盤 \ 鍵（Enter上方）：切換完全隱形/顯形

local function applyHitbox(player)
    if player == LocalPlayer then return end
    pcall(function()
        local character = player.Character
        if character then
            local root = character:FindFirstChild("HumanoidRootPart")
            local humanoid = character:FindFirstChildOfClass("Humanoid")
            if root and humanoid and humanoid.Health > 0 then
                root.Size = Vector3.new(CurrentSize, CurrentSize, CurrentSize)
                root.Transparency = CurrentTransparency
                root.Color = Color3.fromRGB(255, 0, 0)
                root.Material = Enum.Material.Neon
                root.CanCollide = false
            end
        end
    end)
end

-- 監聽鍵盤按鍵（免UI動態控制）
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    
    -- 調整大小
    if input.KeyCode == KEY_SIZE_UP then
        CurrentSize = math.clamp(CurrentSize + 2, 2, 100)
        print("Hitbox Size Updated: " .. tostring(CurrentSize))
    elseif input.KeyCode == KEY_SIZE_DOWN then
        CurrentSize = math.clamp(CurrentSize - 2, 2, 100)
        print("Hitbox Size Updated: " .. tostring(CurrentSize))
        
    -- 調整透明度（切換隱形或顯形）
    elseif input.KeyCode == KEY_TOGGLE_HIDE then
        if CurrentTransparency == 0 then
            CurrentTransparency = 0.6 -- 恢復成看得到紅框
        else
            CurrentTransparency = 0 -- 變成 0 完全隱形方塊（但依然是大方塊）
        end
        print("Hitbox Transparency Updated: " .. tostring(CurrentTransparency))
    end
end)

-- 背景不斷同步刷新
RunService.RenderStepped:Connect(function()
    for _, player in ipairs(Players:GetPlayers()) do
        applyHitbox(player)
    end
end)
    end
end)
    end
end)
