StatusLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
StatusLabel.TextSize = 12
StatusLabel.Font = Enum.Font.SourceSansItalic
StatusLabel.BackgroundTransparency = 1
StatusLabel.Parent = MainFrame


-- === 2. 核心轉換與跳轉邏輯 (修正版) ===
TeleportButton.MouseButton1Click:Connect(function()
    -- 清除前後不小心留下的空白
    local inputText = string.gsub(TextBox.Text, "^%s*(.-)%s*$", "%1")
    
    if inputText == "" then
        StatusLabel.Text = "❌ 輸入欄位不能為空！"
        StatusLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
        return
    end
    
    StatusLabel.Text = "🔍 正在檢查玩家資訊..."
    StatusLabel.TextColor3 = Color3.fromRGB(255, 200, 50)
    
    task.spawn(function()
        local targetId = tonumber(inputText)
        
        -- 如果輸入的不是純數字，嘗試轉換名字
        if not targetId then
            local idSuccess, idResult = pcall(function()
                return Players:GetUserIdFromNameAsync(inputText)
            end)
            if idSuccess then
                targetId = idResult
            else
                StatusLabel.Text = "❌ 找不到這個玩家名稱！"
                StatusLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
                return
            end
        end
        
        StatusLabel.Text = "🛰️ 正在搜尋該玩家的伺服器..."
        
        -- 【關鍵修正】Roblox 最新官方 API 會回傳 5 個參數，必須精準抓取 jobId (第 4 位)
        local tpSuccess, currentPlaceId, jobId = pcall(function()
            local success, errorMsg, pId, jId, _ = TeleportService:GetPlayerPlaceInstanceAsync(targetId)
            if success then
                return pId, jId
            else
                error(errorMsg or "無法取得伺服器實例")
            end
        end)
        
        if tpSuccess and currentPlaceId and jobId then
            StatusLabel.Text = "✅ 成功找到伺服器！正在傳送..."
            StatusLabel.TextColor3 = Color3.fromRGB(100, 255, 100)
            task.wait(0.5)
            
            -- 執行傳送
            local success, err = pcall(function()
                TeleportService:TeleportToPlaceInstance(currentPlaceId, jobId, LocalPlayer)
            end)
            
            if not success then
                StatusLabel.Text = "❌ 傳送失敗: API 拒絕請求"
                StatusLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
                warn(err)
            end
        else
            StatusLabel.Text = "❌ 失敗: 玩家離線或隱私/VIP 限制"
            StatusLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
        end
    end)
end)
