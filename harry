ApplyButton.MouseButton1Click:Connect(function()
    local newSize = tonumber(SizeInput.Text)
    local newTrans = tonumber(TransInput.Text)
    
    if newSize and newSize >= 2 and newSize <= 100 and newTrans and newTrans >= 0 and newTrans <= 1 then
        Settings.Size = newSize
        Settings.Transparency = newTrans
        ApplyButton.Text = "SUCCESS"
        ApplyButton.BackgroundColor3 = Color3.fromRGB(76, 175, 80)
        task.wait(0.8)
        ApplyButton.Text = "Update Hitbox"
        ApplyButton.BackgroundColor3 = Color3.fromRGB(0, 150, 136)
    else
        ApplyButton.Text = "ERROR"
        ApplyButton.BackgroundColor3 = Color3.fromRGB(244, 67, 54)
        task.wait(1.2)
        ApplyButton.Text = "Update Hitbox"
        ApplyButton.BackgroundColor3 = Color3.fromRGB(0, 150, 136)
    end
end)

local function applyHitbox(player)
    if player == LocalPlayer then return end
    pcall(function()
        local character = player.Character
        if character then
            local root = character:FindFirstChild("HumanoidRootPart")
            local humanoid = character:FindFirstChildOfClass("Humanoid")
            if root and humanoid and humanoid.Health > 0 then
                root.Size = Vector3.new(Settings.Size, Settings.Size, Settings.Size)
                root.Transparency = Settings.Transparency
                root.Color = Color3.fromRGB(255, 0, 0)
                root.Material = Enum.Material.Neon
                root.CanCollide = false
            end
        end
    end)
end

RunService.RenderStepped:Connect(function()
    if not ExtenderEnabled then return end
    for _, player in ipairs(Players:GetPlayers()) do
        applyHitbox(player)
    end
end)
