-- === ⚙️ 調整參數設定區 ===
local HITBOX_SIZE = Vector3.new(15, 15, 15)  -- 【調整大小】預設 15，數字越大方塊越大（例如改成 8, 8, 8 會變小）
local HITBOX_TRANSPARENCY = 0.6               -- 【調整透明度】0 為完全看不見，0.5 為半透明，1 為完全變紅色（看不到人）
local HITBOX_COLOR = Color3.fromRGB(255, 0, 0)-- 【調整顏色】目前是發光紅色

-- === 🔒 核心注入邏輯 (請勿修改) ===
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

local function applyHitbox(player)
    if player == LocalPlayer then return end
    
    pcall(function()
        local character = player.Character
        if character then
            local root = character:FindFirstChild("HumanoidRootPart")
            local humanoid = character:FindFirstChildOfClass("Humanoid")
            
            if root and humanoid and humanoid.Health > 0 then
                root.Size = HITBOX_SIZE
                root.Transparency = HITBOX_TRANSPARENCY
                root.Color = HITBOX_COLOR
                root.Material = Enum.Material.Neon
                root.CanCollide = false
            end
        end
    end)
end

RunService.RenderStepped:Connect(function()
    for _, player in ipairs(Players:GetPlayers()) do
        applyHitbox(player)
    end
end)
